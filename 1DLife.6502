
   10 OSWRCH=&FFEE
   20 OSWORD=&FFF1
   30 seed=&70
   40 clk_buf=&71
   50 width%=&76
   60 count%=&77
   70 DIM CODE% 400
   80 FOR Z=0 TO 3 STEP 3
   90 P%=CODE%
  100 [OPT Z
  110 .start
  120    LDA #78         ;78 characters wide for mode 0
  130    STA width%
  140    JSR init_rng    ; initialise the random number generator
  150    LDA #22
  160    JSR OSWRCH
  170    LDA #0
  180    JSR OSWRCH      ; mode 0  
  190 .mainLoop
  200    LDA #13             ;move to start of line
  210    JSR OSWRCH  
  220    LDX width%           ; Set X to width% - the number of characters wide   
  230 .initialiseData
  240    JSR get_random     ; get a random number
  250    CMP #128         ;if less than 127 (half of 255) store a 1, else store a 0
  260    BCC willBeZero     ;less than 127 so will be a zero
  270    LDA #42
  280    JSR OSWRCH         ;print *
  290    JMP storeValue
  300 .willBeZero    
  310    LDA #32             ;print a space
  320    JSR OSWRCH
  330 .storeValue
  340    STA dataX-78,X  ; store it a dataX less X register
  350    DEX
  360    BPL initialiseData
  370 .repeat25TimesAndResetRandom
  380    LDY #25  
  390 .calculateLifeLoop
  400    LDX #76  
  410 .getDataLoop
  420    LDA #0:STA count%;step through I+2 down to I-2 ignoring I
  430    INX:INX     ;I+2
  440    LDA dataX-78,X
  450    CMP #42
  460    BNE IPlusOne
  470    INC count%
  480 .IPlusOne
  490    DEX         ;I+1
  500    LDA dataX-78,X
  510    CMP #42
  520    BNE IMinusOne
  530    INC count%
  540 .IMinusOne  
  550    DEX     ;skip the current cell (I)
  560    DEX    ;I-1
  570    LDA dataX-78,X
  580    CMP #42
  590    BNE IMinusTwo
  600    INC count%
  610 .IMinusTwo
  620    DEX    ;I-2
  630    LDA dataX-78,X
  640    CMP #42
  650    BNE endOfILoop
  660    INC count%
  670 .endOfILoop
  680    INX: INX ;back to initial loop value
  690    LDA dataX-78,X:CMP #32:BNE currentlyStar
  700    LDA #32:STA dataY-78,X
  710    LDA count%:CMP #2:BEQ setStar
  720    CMP #3:BEQ setStar
  730    JMP endOfLifeCount
  740 .currentlyStar
  750    LDA #32:STA dataY-78,X
  760    LDA count%:CMP #2:BEQ setStar
  770    CMP #4:BEQ setStar
  780    JMP endOfLifeCount
  790 .setStar
  800    LDA #42:STA dataY-78,X
  810 .endOfLifeCount
  820    DEX  ;initial loop value -1 (e.g 75 from 76) 
  830    CPX #02
  840    BNE getDataLoop
  850 .drawLoop
  860    JSR newLine
  870    LDX width%        ; Set X to width% - the number of characters wide
  880 .drawLine
  890    LDA dataY-78,X                 ;copy dataY to dataX
  900    STA dataX-78,X                 ;save it
  910    JSR OSWRCH
  920    DEX
  930    BPL drawLine
  940    DEY
  950    BPL calculateLifeLoop
  960    JMP mainLoop
  970 .newLine
  980    LDA #13:JSR OSWRCH:LDA #10:JSR OSWRCH
  990    RTS
 1000 .init_rng
 1010    LDA #01
 1020    LDX #clk_buf    ; Point X to the buffer low byte
 1030    LDY #0          ; Point Y to the buffer high byte (0 for Zero Page)
 1040    JSR OSWORD
 1050    LDA clk_buf
 1060    EOR clk_buf+1
 1070    EOR clk_buf+2
 1080    BNE store_seed  ;If the result is not zero, go ahead and store it
 1090    LDA #&55
 1100 .store_seed
 1110    STA seed
 1120    RTS
 1130 .get_random
 1140    LDA seed        ; Load our current 8-bit seed
 1150    LSR A           ; Shift right (bit 0 drops into Carry)
 1160    BCC no_tap     ; If Carry was 0, skip the XOR tap
 1170    EOR #&B8        ; If Carry was 1, apply the Galois polynomial tap (Hex B8900)
 1180 .no_tap
 1190    STA seed        ; Save the updated seed for next time
 1200    RTS             ; Return with the random number still in A
 1210    EQUS "                                                                               "
 1220 .dataX
 1230    EQUS "                                                                               "
 1240 .dataY
 1250 .end
 1260 ]:NEXT Z
 1270 CALL start
